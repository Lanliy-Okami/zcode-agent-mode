{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1",
              "pre-tool-use"
            ],
            "timeoutMs": 10000,
            "statusMessage": "Agent Mode policy check"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1",
              "user-prompt-submit"
            ],
            "timeoutMs": 10000,
            "statusMessage": "Agent Mode context"
          }
        ]
      }
    ]
  }
}
