{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": ["-X", "utf8", "-I", "${CLAUDE_PLUGIN_ROOT}/scripts/agent_mode_hook.py", "pre-tool-use"],
            "timeoutMs": 10000,
            "statusMessage": "Agent Mode policy check"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": ["-X", "utf8", "-I", "${CLAUDE_PLUGIN_ROOT}/scripts/agent_mode_hook.py", "user-prompt-submit"],
            "timeoutMs": 10000,
            "statusMessage": "Agent Mode context"
          }
        ]
      }
    ]
  }
}
