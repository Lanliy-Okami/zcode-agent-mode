{
  "mcpServers": {
    "agent-mode": {
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/scripts/run_server.ps1"
      ],
      "cwd": "${CLAUDE_PROJECT_DIR}",
      "env": {
        "PYTHONUTF8": "1",
        "AGENT_MODE_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "AGENT_MODE_PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
