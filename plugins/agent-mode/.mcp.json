{
  "mcpServers": {
    "agent-mode": {
      "command": "python",
      "args": ["-X", "utf8", "-I", "${CLAUDE_PLUGIN_ROOT}/mcp/run_code_server.py"],
      "cwd": "${CLAUDE_PROJECT_DIR}",
      "env": {
        "PYTHONUTF8": "1",
        "AGENT_MODE_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "AGENT_MODE_PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
